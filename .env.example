# ─────────────────────────────────────────────────────────────────────────────
# Dawa Mobile — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#
# EXPO_PUBLIC_* variables are bundled into the app binary and visible to users.
# Never put secrets (certificates, private keys, API secrets) in EXPO_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

# Clerk Authentication (publishable key is safe to expose)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Supabase (anon key is safe to expose — RLS enforces access control)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Agora (App ID is safe to expose; certificate must NEVER be in the app)
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id_here

# Stream Chat (API key is safe to expose; secret must stay server-side)
EXPO_PUBLIC_STREAM_API_KEY=your_stream_api_key_here

# Web app URL — used as Chapa return_url (must be HTTPS; Chapa rejects custom schemes)
# Set to http://localhost:3000 in dev, your Vercel URL in production.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# DEV-ONLY: skips the Chapa checkout in the Patient Mobile App (Android/iOS)
# and simulates a successful payment instead, for use while the Chapa
# merchant account is unavailable. Has no effect outside __DEV__ builds.
# MUST be false (or unset) in production / release builds.
EXPO_PUBLIC_DEV_PAYMENT_BYPASS=false
