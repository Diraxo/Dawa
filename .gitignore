# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env contains real Supabase keys, never commit
.env
.env*.local
.env.production
.env.production.local

# Firebase service account credentials — never commit these
*firebase-adminsdk*.json
carehub-ce3e3-*.json
google-services.json

# Android release signing keystore — never commit, keep the only copy backed up offline
credentials/
*.keystore
*.jks

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
