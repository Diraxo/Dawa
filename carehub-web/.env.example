# ─────────────────────────────────────────────────────────────────────────────
# Dawa Web (Next.js) — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
#
# NEXT_PUBLIC_* variables are bundled into the client bundle and visible to users.
# Never put secrets in NEXT_PUBLIC_* variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk Authentication ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here          # SERVER-SIDE ONLY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # SERVER-SIDE ONLY

# ── Stream Chat ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here         # SERVER-SIDE ONLY

# ── Agora ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here # SERVER-SIDE ONLY

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here               # SERVER-SIDE ONLY
